# ── Required ─────────────────────────────────────────────
# Google AI API key — used server-side by the Express proxy.
GEMINI_API_KEY=

# ── Supabase (optional) ─────────────────────────────────
# Omit these to run in offline mode (no auth, no persistence).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Server (optional) ───────────────────────────────────
# PORT=3001
# TRUST_PROXY=1
# FRONTEND_URL=https://your-production-domain.com
